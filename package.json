{
  "name": "universal-authorization-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A developer-friendly authorization engine: can SUBJECT perform ACTION on RESOURCE under the current POLICY and CONTEXT?",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "tinypool": "^2.1.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18.14"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck && pnpm run typecheck:workspace",
    "typecheck:workspace": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm run build && node scripts/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^18.19.68",
    "eslint": "^9.17.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.4"
  }
}
