{
  "name": "@uae/cli",
  "version": "0.1.0",
  "description": "authz CLI — validate, test, and check authorization policies locally",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "authz": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @uae/evaluator run build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @uae/evaluator run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../../"
  },
  "dependencies": {
    "@uae/core": "workspace:*",
    "@uae/evaluator": "workspace:*",
    "@uae/policy": "workspace:*"
  }
}
