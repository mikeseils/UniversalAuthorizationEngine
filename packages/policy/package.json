{
  "name": "@uae/policy",
  "version": "0.1.0",
  "description": "Structured policy representation, validation, compilation, and versioning",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @uae/core run build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @uae/core run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@uae/core": "workspace:*"
  }
}
