# Example environment values for local development.
#
# Copy to `.env` and adjust. `.env` and `.env.*` are gitignored — never commit a
# real connection string, credential, or token (see SECURITY.md).
#
# Docker is NOT required. Everything below is optional: with no database
# configured, the Postgres suites skip and `pnpm test` still passes.

# Connection string for the optional PostgreSQL suites. Any reachable Postgres
# works, including a throwaway local container. Example placeholder only:
AUTHZ_TEST_PG_URL=postgres://postgres:postgres@localhost:5432/uae_test

# Data-plane deployment (Dockerfile, docker-compose.yml,
# packages/data-plane/bin/start.js). All optional; defaults shown.
#
# Listen port.
# PORT=3000
#
# Comma-separated API keys accepted from `Authorization: Bearer <key>` or
# `X-API-Key: <key>`. Unset/empty = dev mode: every request is accepted.
# Never ship dev mode to production.
# UAE_API_KEYS=replace-with-a-long-random-value
#
# Path to a compiled policy artifact JSON. Unset/empty = the data plane starts
# with an empty store and every check fails closed (HTTP 503) until an
# artifact is configured.
# UAE_ARTIFACT_PATH=/app/artifact/policy.json
#
# Path to a JSON map of keyId -> PEM public key for artifact signature
# verification (ADR-0024).
# UAE_PUBLIC_KEYS_PATH=/app/artifact/keys.json
#
# "true" rejects unsigned artifacts at startup (fail-closed).
# UAE_REQUIRE_SIGNATURE=false

