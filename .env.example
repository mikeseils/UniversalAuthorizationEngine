# Example environment values for local development.
#
# Copy to `.env` and adjust. `.env` and `.env.*` are gitignored — never commit a
# real connection string, credential, or token (see SECURITY.md).
#
# Docker is NOT required. Everything below is optional: with no database
# configured, the Postgres suites skip and `pnpm test` still passes.

# Connection string for the optional PostgreSQL suites. Any reachable Postgres
# works, including a throwaway local container. Example placeholder only:
AUTHZ_TEST_PG_URL=postgres://postgres:postgres@localhost:5432/uae_test
